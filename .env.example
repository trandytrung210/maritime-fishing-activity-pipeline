# Local development environment
# Copy this file to .env and replace placeholder values.

# SeaweedFS S3 connection
S3_ENDPOINT=http://127.0.0.1:8333
AWS_ACCESS_KEY_ID=REPLACE_WITH_SEAWEED_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SEAWEED_SECRET_KEY

# Silver processing
# Empty = normal incremental processing
# all / true / 1 / * = force reprocess all dates
# Or specify dates separated by commas
SILVER_FORCE_REPROCESS=
