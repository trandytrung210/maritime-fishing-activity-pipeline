# Copy to airflow/.env (do not commit .env)
#   copy .env.example .env
#
# Generate secrets (PowerShell):
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Shared network (once):
#   docker network create maritime-shared
#
# Start SeaweedFS first, then Airflow:
#   cd ../infrastructure && docker compose up -d
#   cd ../airflow && docker compose build && docker compose up -d
#
# Staging (baked image from GHCR, no source mount):
#   export AIRFLOW_IMAGE=ghcr.io/<owner>/maritime-fishing-airflow:latest
#   docker compose -f docker-compose.staging.yml pull
#   docker compose -f docker-compose.staging.yml up -d
# Or: ../scripts/deploy_staging.sh

AIRFLOW_UID=50000
# AIRFLOW_IMAGE=ghcr.io/<owner>/maritime-fishing-airflow:latest
# AIRFLOW_UI_PORT=8080
# MARITIME_DATA_DIR=../data
# MARITIME_REPORTS_DIR=../reports

FERNET_KEY=REPLACE_WITH_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_JWT_SECRET

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Must match infrastructure/s3.json
# Host scripts (.env at repo root): http://127.0.0.1:8333
# Airflow containers: http://s3:8333 (service name on maritime-shared)
S3_ENDPOINT=http://s3:8333
AWS_ACCESS_KEY_ID=REPLACE_WITH_SEAWEED_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SEAWEED_SECRET_KEY
